import { katexReplaceWithTex } from "./katex2tex.lil";
import extern { isInstance as instanceOfHost } from "./instanceof.js";

extern bool instanceOfHost(JsValue value, JsValue constructor);

extern JsValue document;
extern JsValue window;
extern JsValue Element;
extern JsValue Text;
extern JsValue Array;

JsValue closestKatex(JsValue node) {
  JsValue element = if (instanceOfHost(node, Element)) { node } else { node["parentElement"] };
  if (element.truthy()) return JS.invoke(element, "closest", ".katex");
  return null;
}

JS.invoke(document, "addEventListener", "copy", (JsValue event) => {
  JsValue selection = JS.invoke(window, "getSelection");
  if (selection["isCollapsed"].truthy() || !event["clipboardData"].truthy()) return;
  JsValue clipboardData = event["clipboardData"];
  JsValue range = JS.invoke(selection, "getRangeAt", 0);
  JsValue startKatex = closestKatex(range["startContainer"]);
  if (startKatex.truthy()) JS.invoke(range, "setStartBefore", startKatex);
  JsValue endKatex = closestKatex(range["endContainer"]);
  if (endKatex.truthy()) JS.invoke(range, "setEndAfter", endKatex);
  JsValue fragment = JS.invoke(range, "cloneContents");
  if (!JS.invoke(fragment, "querySelector", ".katex-mathml").truthy()) return;
  JsValue mapped = JS.call(Array["prototype"]["map"], fragment["childNodes"], (JsValue element) => {
    if (instanceOfHost(element, Text)) return element["textContent"];
    return element["outerHTML"];
  });
  JS.invoke(clipboardData, "setData", "text/html", JS.invoke(mapped, "join", ""));
  JS.invoke(clipboardData, "setData", "text/plain", katexReplaceWithTex(fragment)["textContent"]);
  JS.invoke(event, "preventDefault");
});
