import extern { default as katex } from "../../dist/katex.mjs";

extern JsValue katex;
extern JsValue document;
extern JsValue RegExp;
extern JsValue Array;

JsValue scripts = JS.invoke(document["body"], "getElementsByTagName", "script");
scripts = JS.call(Array["prototype"]["slice"], scripts);
JS.invoke(scripts, "forEach", (JsValue script) => {
  if (script["type"].truthy() && JS.invoke(script["type"], "match", JS.construct(RegExp, "math/tex", "i")).truthy()) {
    bool display = !JS.isNullish(JS.invoke(script["type"], "match", JS.construct(RegExp, "mode\\s*=\\s*display(;|\\s|\\n|$)", "")));
    JsValue katexElement = JS.invoke(document, "createElement", if (display) { "div" } else { "span" });
    JS.invoke(katexElement, "setAttribute", "class", if (display) { "equation" } else { "inline-equation" });
    try {
      JS.invoke(katex, "render", script["text"], katexElement, JS.object("displayMode", display));
    } catch (JsValue error) {
      katexElement["textContent"] = script["text"];
    }
    JS.invoke(script["parentNode"], "replaceChild", katexElement, script);
  }
});
