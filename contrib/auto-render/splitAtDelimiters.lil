pure int findEndOfMath(string delimiter, string text, int startIndex) {
  int index = startIndex;
  int braceLevel = 0;
  int delimiterLength = delimiter.length;
  while (index < text.length) {
    string character = text.charAt(index);
    if (braceLevel <= 0 && text.slice(index, index + delimiterLength) == delimiter) {
      return index;
    }
    if (character == "\\") index += 1;
    else if (character == "{") braceLevel += 1;
    else if (character == "}") braceLevel -= 1;
    index += 1;
  }
  return -1;
}

struct DelimiterHit {
  int offset;
  int delimiterIndex;
}

DelimiterHit findLeftDelimiter(string text, JsValue delimiters) {
  int foundIndex = -1;
  int foundDelimiter = -1;
  int i = 0;
  int count = JS.number(delimiters["length"]).toInt();
  while (i < count) {
    int candidate = text.indexOf(JS.string(delimiters[i]["left"]));
    if (candidate >= 0 && (foundIndex < 0 || candidate < foundIndex)) {
      foundIndex = candidate;
      foundDelimiter = i;
    }
    i += 1;
  }
  return DelimiterHit{foundIndex, foundDelimiter};
}

export JsValue splitAtDelimiters(string text, JsValue delimiters) {
  JsValue data = JS.array();
  while (true) {
    DelimiterHit hit = findLeftDelimiter(text, delimiters);
    int index = hit.offset;
    if (index == -1) break;
    if (index > 0) {
      JS.push(data, JS.object("type", "text", "data", text.slice(0, index)));
      text = text.slice(index);
    }
    int delimiterIndex = hit.delimiterIndex;
    string left = JS.string(delimiters[delimiterIndex]["left"]);
    string right = JS.string(delimiters[delimiterIndex]["right"]);
    index = findEndOfMath(right, text, left.length);
    if (index == -1) break;
    string rawData = text.slice(0, index + right.length);
    string math = rawData;
    if (!rawData.startsWith("\\begin{")) math = text.slice(left.length, index);
    JS.push(data, JS.object(
      "type", "math",
      "data", math,
      "rawData", rawData,
      "display", delimiters[delimiterIndex]["display"]
    ));
    text = text.slice(index + right.length);
  }
  if (text != "") JS.push(data, JS.object("type", "text", "data", text));
  return data;
}

export { splitAtDelimiters as default };
