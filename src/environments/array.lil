JsValue getHLines(JsValue parser) {
  JsValue hlineInfo = JS.array();
  JS.invoke(parser, "consumeSpaces");
  string nxt = toStr(JS.invoke(parser, "fetch")["text"]);
  if (nxt == "\\relax") {
    JS.invoke(parser, "consume");
    JS.invoke(parser, "consumeSpaces");
    nxt = toStr(JS.invoke(parser, "fetch")["text"]);
  }
  while (nxt == "\\hline" || nxt == "\\hdashline") {
    JS.invoke(parser, "consume");
    JS.push(hlineInfo, nxt == "\\hdashline");
    JS.invoke(parser, "consumeSpaces");
    nxt = toStr(JS.invoke(parser, "fetch")["text"]);
  }
  return hlineInfo;
}
void validateAmsEnvironmentContext(JsValue context) {
