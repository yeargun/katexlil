export int KIND_ATOM = 0;
export int KIND_LIST = 1;
export int KIND_SUPSUB = 2;
export int KIND_FRAC = 3;
export int KIND_SQRT = 4;
export int KIND_MATRIX = 5;
export int KIND_SPACE = 6;

export class Node {
  int kind;
  string atomClass;
  string text;
  bool italic;
  Node[] kids;
  Node? base;
  Node? sup;
  Node? sub;
  Node? num;
  Node? den;
  string openDelim;
  string closeDelim;

  init() {
    this.kind = 0;
    this.atomClass = "mord";
    this.text = "";
    this.italic = false;
    this.kids = [];
    this.base = null;
    this.sup = null;
    this.sub = null;
    this.num = null;
    this.den = null;
    this.openDelim = "";
    this.closeDelim = "";
  }
}

export Node makeAtom(string atomClass, string text, bool italic) {
  Node node = new Node();
  node.kind = KIND_ATOM;
  node.atomClass = atomClass;
  node.text = text;
  node.italic = italic;
  return node;
}

export Node makeList() {
  Node node = new Node();
  node.kind = KIND_LIST;
  return node;
}

export Node makeSupSub(Node base, Node? sup, Node? sub) {
  Node node = new Node();
  node.kind = KIND_SUPSUB;
  node.base = base;
  node.sup = sup;
  node.sub = sub;
  return node;
}

export Node makeFrac(Node num, Node den) {
  Node node = new Node();
  node.kind = KIND_FRAC;
  node.num = num;
  node.den = den;
  return node;
}

export Node makeSqrt(Node body) {
  Node node = new Node();
  node.kind = KIND_SQRT;
  node.base = body;
  return node;
}

export Node makeMatrix(Node[] rows, string openDelim, string closeDelim) {
  Node node = new Node();
  node.kind = KIND_MATRIX;
  node.kids = rows;
  node.openDelim = openDelim;
  node.closeDelim = closeDelim;
  return node;
}

export Node makeSpace(string width) {
  Node node = new Node();
  node.kind = KIND_SPACE;
  node.text = width;
  return node;
}

export void makeRoman(Node node) {
  node.italic = false;
  int i = 0;
  while (i < node.kids.length) {
    makeRoman(node.kids[i]);
    i = i + 1;
  }
  Node? base = node.base;
  if (base != null) {
    makeRoman(base);
  }
  Node? sup = node.sup;
  if (sup != null) {
    makeRoman(sup);
  }
  Node? sub = node.sub;
  if (sub != null) {
    makeRoman(sub);
  }
  Node? num = node.num;
  if (num != null) {
    makeRoman(num);
  }
  Node? den = node.den;
  if (den != null) {
    makeRoman(den);
  }
}
