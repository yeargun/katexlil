import {
  KIND_ATOM,
  KIND_LIST,
  KIND_SUPSUB,
  KIND_FRAC,
  KIND_SQRT,
  KIND_MATRIX,
  KIND_SPACE,
  Node
} from "./ast.lil";
import { parseTex } from "./parse.lil";

export string escapeHtml(string text) {
  string out = "";
  int i = 0;
  while (i < text.length) {
    string ch = text.charAt(i);
    if (ch == "&") {
      out = out + "&amp;";
    } else if (ch == "<") {
      out = out + "&lt;";
    } else if (ch == ">") {
      out = out + "&gt;";
    } else if (ch == "\"") {
      out = out + "&quot;";
    } else {
      out = out + ch;
    }
    i = i + 1;
  }
  return out;
}

class Html {
  bool displayMode;

  init(bool displayMode) {
    this.displayMode = displayMode;
  }

  int atomKind(Node node) {
    if (node.kind == KIND_ATOM) {
      string klass = node.atomClass;
      if (klass.startsWith("mop")) {
        return 1;
      }
      if (klass == "mbin") {
        return 2;
      }
      if (klass == "mrel") {
        return 3;
      }
      if (klass == "mopen") {
        return 4;
      }
      if (klass == "mclose") {
        return 5;
      }
      if (klass == "mpunct") {
        return 6;
      }
      if (klass == "minner") {
        return 7;
      }
      return 0;
    }
    if (node.kind == KIND_SPACE) {
      return -1;
    }
    if (node.kind == KIND_LIST) {
      if (node.kids.length == 1) {
        return this.atomKind(node.kids[0]);
      }
      return 7;
    }
    if (node.kind == KIND_SUPSUB) {
      Node? baseKind = node.base;
      if (baseKind != null) {
        return this.atomKind(baseKind);
      }
    }
    return 0;
  }

  string spaceWidth(int left, int right) {
    if (left < 0 || right < 0) {
      return "";
    }
    string table = "0123000111030001220020023300300300000000012300011101111111230101";
    int index = left * 8 + right;
    if (index < 0 || index >= table.length) {
      return "";
    }
    string mark = table.charAt(index);
    if (mark == "1") {
      return "0.1667em";
    }
    if (mark == "2") {
      return "0.2222em";
    }
    if (mark == "3") {
      return "0.2778em";
    }
    return "";
  }

  string spanClass(string klass, string inner) {
    return "<span class=\"" + klass + "\">" + inner + "</span>";
  }

  string renderAtom(Node node) {
    string klass = node.atomClass;
    if (node.italic) {
      klass = klass + " mathnormal";
    }
    if (klass == "mop" && (node.text == "∑" || node.text == "∏" || node.text == "∫")) {
      if (this.displayMode) {
        klass = "mop op-symbol large-op";
      } else {
        klass = "mop op-symbol small-op";
      }
    }
    return this.spanClass(klass, escapeHtml(node.text));
  }

  string renderKids(Node[] kids) {
    string html = "";
    int prev = -1;
    int i = 0;
    while (i < kids.length) {
      Node kid = kids[i];
      int kind = this.atomKind(kid);
      if (kind >= 0 && prev >= 0) {
        string width = this.spaceWidth(prev, kind);
        if (width != "") {
          html = html + "<span class=\"mspace\" style=\"margin-right:" + width + "\"></span>";
        }
      }
      html = html + this.render(kid);
      if (kind >= 0) {
        prev = kind;
      }
      i = i + 1;
    }
    return html;
  }

  string renderSupSub(Node node) {
    string base = "";
    Node? baseNode = node.base;
    if (baseNode != null) {
      base = this.render(baseNode);
    }
    string scripts = "";
    Node? supNode = node.sup;
    Node? subNode = node.sub;
    if (supNode != null && subNode != null) {
      scripts = "<span class=\"msupsub\" style=\"display:inline-flex;flex-direction:column;vertical-align:middle;font-size:0.7em;line-height:1.1\"><span class=\"mord\">"
        + this.render(supNode)
        + "</span><span class=\"mord\">"
        + this.render(subNode)
        + "</span></span>";
    } else if (supNode != null) {
      scripts = "<span class=\"msupsub\"><span class=\"mord\" style=\"font-size:0.7em;vertical-align:0.5em\">"
        + this.render(supNode)
        + "</span></span>";
    } else if (subNode != null) {
      scripts = "<span class=\"msupsub\"><span class=\"mord\" style=\"font-size:0.7em;vertical-align:-0.3em\">"
        + this.render(subNode)
        + "</span></span>";
    }
    return this.spanClass("mord msubsup", base + scripts);
  }

  string renderFrac(Node node) {
    string num = "";
    string den = "";
    Node? numNode = node.num;
    Node? denNode = node.den;
    if (numNode != null) {
      num = this.render(numNode);
    }
    if (denNode != null) {
      den = this.render(denNode);
    }
    return "<span class=\"mfrac\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.36em\"><span style=\"top:-2.31em\"><span class=\"pstrut\" style=\"height:3em\"></span><span class=\"mord\">"
      + num
      + "</span></span><span style=\"top:-1.33em\"><span class=\"pstrut\" style=\"height:3em\"></span><span class=\"frac-line\" style=\"border-bottom-width:0.04em\"></span></span><span style=\"top:-0.68em\"><span class=\"pstrut\" style=\"height:3em\"></span><span class=\"mord\">"
      + den
      + "</span></span></span><span class=\"vlist-s\">&#8203;</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.68em\"><span></span></span></span></span></span>";
  }

  string renderSqrt(Node node) {
    string body = "";
    Node? bodyNode = node.base;
    if (bodyNode != null) {
      body = this.render(bodyNode);
    }
    return "<span class=\"sqrt\"><span class=\"mord\">√</span><span class=\"mord\" style=\"border-top:0.08em solid currentColor;padding:0.05em 0.12em 0 0.08em\">"
      + body
      + "</span></span>";
  }

  string renderMatrix(Node node) {
    string rows = "";
    int r = 0;
    while (r < node.kids.length) {
      Node row = node.kids[r];
      string cells = "";
      int c = 0;
      while (c < row.kids.length) {
        if (c > 0) {
          cells = cells + "<span class=\"mspace\" style=\"width:0.5em\"></span>";
        }
        cells = cells + this.render(row.kids[c]);
        c = c + 1;
      }
      rows = rows + "<span style=\"display:block\">" + cells + "</span>";
      r = r + 1;
    }
    string inner = "<span class=\"mord\" style=\"display:inline-block;vertical-align:middle;text-align:center\">"
      + rows
      + "</span>";
    string html = "";
    if (node.openDelim != "") {
      html = html + this.spanClass("mopen", escapeHtml(node.openDelim));
    }
    html = html + inner;
    if (node.closeDelim != "") {
      html = html + this.spanClass("mclose", escapeHtml(node.closeDelim));
    }
    return this.spanClass("minner", html);
  }

  string render(Node node) {
    if (node.kind == KIND_ATOM) {
      return this.renderAtom(node);
    }
    if (node.kind == KIND_LIST) {
      return this.renderKids(node.kids);
    }
    if (node.kind == KIND_SUPSUB) {
      return this.renderSupSub(node);
    }
    if (node.kind == KIND_FRAC) {
      return this.renderFrac(node);
    }
    if (node.kind == KIND_SQRT) {
      return this.renderSqrt(node);
    }
    if (node.kind == KIND_MATRIX) {
      return this.renderMatrix(node);
    }
    if (node.kind == KIND_SPACE) {
      return "<span class=\"mspace\" style=\"width:" + node.text + "\"></span>";
    }
    return "";
  }
}

string wrapKatex(string inner, bool displayMode) {
  string html = "<span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\">"
    + inner
    + "</span></span></span>";
  if (displayMode) {
    return "<span class=\"katex-display\">" + html + "</span>";
  }
  return html;
}

string errorSpan(string tex, string errorColor) {
  return "<span class=\"katex-error\" style=\"color:"
    + escapeHtml(errorColor)
    + "\">"
    + escapeHtml(tex)
    + "</span>";
}

export string renderTex(string tex, bool displayMode, bool throwOnError, string errorColor) {
  try {
    Node root = parseTex(tex);
    Html html = new Html(displayMode);
    return wrapKatex(html.render(root), displayMode);
  } catch (JsValue err) {
    if (throwOnError) {
      throw err;
    }
    return errorSpan(tex, errorColor);
  }
}
